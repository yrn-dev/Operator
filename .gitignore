# Dependencies
node_modules/

# NOTE: dist/ is tracked on purpose — it is the current built operator
# (the npm package ships dist, no src in this repo).

# OS
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*

# Environment (may contain secrets)
.env
.env.*
.envrc

# Editor
.vscode/
.idea/
*.swp
*.swo

# Local agent state (auth.json, sessions, memory — user-specific, secrets)
.opr/
~/.opr/
auth.json
models.json
tasks.json

# Shrinkwrap (regenerate per env)
npm-shrinkwrap.json
